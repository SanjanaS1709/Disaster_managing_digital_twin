SIMULATION_STORAGE_BACKEND=local
SIMULATION_DB_PATH=data/simulation_state.json
DECISION_DB_PATH=data/decisions.json
FIREBASE_PROJECT_ID=
# Path to a secured service-account JSON OUTSIDE the repository; or use ADC.
FIREBASE_SERVICE_ACCOUNT_JSON=
# No scheme, e.g. 127.0.0.1:8080. Set ONLY for an emulator.
FIRESTORE_EMULATOR_HOST=
FIRESTORE_COLLECTION=agentic_disaster_twin
FIRESTORE_NAMESPACE=simulation
# Set to firestore for durable assistant chat history and approved guidance retrieval.
# Local mode keeps history in process memory and does not retrieve knowledge documents.
ASSISTANT_STORAGE_BACKEND=memory
