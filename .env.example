GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
# Firestore is optional; use Application Default Credentials or point to a secure
# service-account JSON file outside the repository.
SIMULATION_STORAGE_BACKEND=local
ASSISTANT_STORAGE_BACKEND=memory
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_EMULATOR_HOST=
FIRESTORE_COLLECTION=agentic_disaster_twin
FIRESTORE_NAMESPACE=simulation
# Optional self-hosted OSRM endpoint. The public OSRM demo service is used by default.
OSRM_BASE_URL=https://router.project-osrm.org
